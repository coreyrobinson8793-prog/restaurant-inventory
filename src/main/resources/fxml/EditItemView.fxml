<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml" spacing="15"
	style="-fx-background-color: #f8f9fa" prefWidth="400"
	fx:controller="com.coreyrobinson.inventory.controller.EditItemController">
	<padding>
		<Insets top="40" right="20" left="20" bottom="15" />
	</padding>
	<Label text="Edit Item"
		style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
	<GridPane hgap="10" vgap="10">
		<!-- Row 0: Name -->
		<Label text="Item Name:" GridPane.rowIndex="0"
			GridPane.columnIndex="0" />
		<TextField fx:id="nameField" prefWidth="220"
			GridPane.rowIndex="0" GridPane.columnIndex="1" />

		<!-- Row 1: Unit -->
		<Label text="Unit:" GridPane.rowIndex="1"
			GridPane.columnIndex="0" />
		<ChoiceBox fx:id="unitChoiceBox" prefWidth="220"
			GridPane.rowIndex="1" GridPane.columnIndex="1" />

		<!-- Row 2: Current Stock -->
		<Label text="Current Stock:" GridPane.rowIndex="2"
			GridPane.columnIndex="0" />
		<TextField fx:id="currentStockField" prefWidth="220"
			GridPane.rowIndex="2" GridPane.columnIndex="1" />

		<!-- Row 3: Parstock -->
		<Label text="Parstock:" GridPane.rowIndex="3"
			GridPane.columnIndex="0" />
		<TextField fx:id="parstockField" prefWidth="220"
			GridPane.rowIndex="3" GridPane.columnIndex="1" />

		<!-- Row 4: Category -->
		<Label text="Category:" GridPane.rowIndex="4"
			GridPane.columnIndex="0" />
		<ChoiceBox fx:id="categoryChoiceBox" prefWidth="220"
			GridPane.rowIndex="4" GridPane.columnIndex="1" />
	</GridPane>
	<Label fx:id="messageLabel" style="-fx-font-size: 12px;" />
	<HBox spacing="10" alignment="CENTER_RIGHT">
		<Button text="Cancel" onAction="#handleCancel" />
		<Button text="Save" onAction="#handleSave" defaultButton="true" />
	</HBox>
</VBox>