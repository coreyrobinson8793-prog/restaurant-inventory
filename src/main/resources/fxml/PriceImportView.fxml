<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
	fx:controller="com.coreyrobinson.inventory.controller.PriceImportController"
	spacing="20" style="-fx-background-color: #f8f9fa">
	<padding>
		<Insets top="40" right="20" left="20" bottom="15" />
	</padding>
	<Label text="Price Imports"
		styleClass="screen-header" />
	<Label fx:id="messageLabel" style="-fx-font-size: 12px;" />
	<Label text="Template"
			styleClass="section-label" />
	<GridPane hgap="10" vgap="5">
		<padding>
			<Insets top="10" right="10" bottom="10" left="10" />
		</padding>
		<Label text="Supplier" GridPane.rowIndex="0" 
			GridPane.columnIndex="0" />
		<ChoiceBox fx:id="supplierChoiceBox" prefWidth="120"
			GridPane.rowIndex="1" GridPane.columnIndex="0" />
		<Label text="SKU" GridPane.rowIndex="0"
			GridPane.columnIndex="1" />
		<TextField fx:id="skuColumnField" prefWidth="150"
			GridPane.rowIndex="1" GridPane.columnIndex="1" />
		<Label text="Price" GridPane.rowIndex="0"
			GridPane.columnIndex="2" />
		<TextField fx:id="priceColumnField" prefWidth="150"
			GridPane.rowIndex="1" GridPane.columnIndex="2" />
		<Label text="Header Row" GridPane.rowIndex="0"
			GridPane.columnIndex="3" />
		<TextField fx:id="headerField" prefWidth="120"
			GridPane.rowIndex="1" GridPane.columnIndex="3" />
	</GridPane>
	<Button onAction="#handleSaveTemplate" text="Save Template" />
	<Label text="Import"
			styleClass="section-label" />
	<HBox spacing="10">
		<Button onAction="#handleChosenFile" text="Choose File" />
		<Label fx:id="selectedFileLabel" text="No File Selected" />
	</HBox>
	<Button onAction="#handleRunImport" text="Run Import" fx:id="runImportButton" disable="true" />
	<TableView fx:id="historyTable" VBox.vgrow="ALWAYS">
		<columns>
			<TableColumn text="Date" prefWidth="150"
				fx:id="dateColumn" />
			<TableColumn text="File" prefWidth="150"
				fx:id="fileColumn" />
			<TableColumn text="Rows Processed" prefWidth="100"
				fx:id="rowsProcessedColumn" />
			<TableColumn text="Rows Updated" prefWidth="100"
				fx:id="rowsUpdatedColumn" />
			<TableColumn text="Rows Skipped" prefWidth="100"
				fx:id="rowsSkippedColumn" />
		</columns>
	</TableView>
</VBox>
	
			
			
			
			