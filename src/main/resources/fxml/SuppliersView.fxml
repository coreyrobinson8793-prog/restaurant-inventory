<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>

<SplitPane dividerPositions="0.55"
	xmlns:fx="http://javafx.com/fxml" style="-fx-background-color: #f8f9fa"
	fx:controller="com.coreyrobinson.inventory.controller.SuppliersController">
	<VBox>
		<padding>
			<Insets top="40" right="20" left="20" bottom="15" />
		</padding>
		<Label text="Suppliers"
			style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
		<Label text="Add New Supplier"
			style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
		<GridPane hgap="10" vgap="5">
			<padding>
				<Insets top="10" right="10" bottom="10" left="10" />
			</padding>
			<Label text="Supplier Name" GridPane.rowIndex="0"
				GridPane.columnIndex="0" />
			<Label text="Representative Name" GridPane.rowIndex="0"
				GridPane.columnIndex="1" />
			<Label text="Phone Number" GridPane.rowIndex="0"
				GridPane.columnIndex="2" />
			<Label text="Email" GridPane.rowIndex="0"
				GridPane.columnIndex="3" />
			<Label text="Address" GridPane.rowIndex="0"
				GridPane.columnIndex="4" />
			<TextField fx:id="supplierNameField" prefWidth="180"
				GridPane.rowIndex="1" GridPane.columnIndex="0" />
			<TextField fx:id="repNameField" prefWidth="180"
				GridPane.rowIndex="1" GridPane.columnIndex="1" />
			<TextField fx:id="phoneField" prefWidth="120"
				GridPane.rowIndex="1" GridPane.columnIndex="2" />
			<TextField fx:id="emailField" prefWidth="180"
				GridPane.rowIndex="1" GridPane.columnIndex="3" />
			<TextField fx:id="addressField" prefWidth="200"
				GridPane.rowIndex="1" GridPane.columnIndex="4" />
		</GridPane>
		<Button onAction="#handleAddSupplier" text="Add Supplier" />
		<Label fx:id="messageLabel" style="-fx-font-size: 12px;" />
		<TableView fx:id="suppliersTable" VBox.vgrow="ALWAYS">
			<columns>
				<TableColumn text="Supplier Name" prefWidth="150"
					fx:id="supplierNameColumn" />
				<TableColumn text="Representative Name" prefWidth="150"
					fx:id="repNameColumn" />
				<TableColumn text="Phone Number" prefWidth="120"
					fx:id="phoneColumn" />
				<TableColumn text="Email" prefWidth="180"
					fx:id="emailColumn" />
				<TableColumn text="Address" prefWidth="200"
					fx:id="addressColumn" />
				<TableColumn text="Actions" prefWidth="100"
					fx:id="actionsColumn" />
				<TableColumn text="Active" prefWidth="80"
					fx:id="activeColumn" />
			</columns>
		</TableView>
	</VBox>
	<VBox>
		<padding>
			<Insets top="40" right="20" left="20" bottom="15" />
		</padding>
		<Label text="Select a Supplier"
			style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"
			fx:id="detailHeaderLabel" />
		<TableView fx:id="supplierItemsTable" VBox.vgrow="ALWAYS">
			<columns>
				<TableColumn text="Item Name" prefWidth="150"
					fx:id="detailItemNameColumn" />
				<TableColumn text="Sku Number" prefWidth="120"
					fx:id="detailSkuColumn" />
				<TableColumn text="Price" prefWidth="100"
					fx:id="detailPriceColumn" />
				<TableColumn text="Pack Size" prefWidth="100"
					fx:id="detailPackSizeColumn" />
				<TableColumn text="Preferred" prefWidth="80"
					fx:id="detailPreferredColumn" />
				<TableColumn text="Actions" prefWidth="100"
					fx:id="detailActionsColumn" />
			</columns>
		</TableView>
	</VBox>
</SplitPane>