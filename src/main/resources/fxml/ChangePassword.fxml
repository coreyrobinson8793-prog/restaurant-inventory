<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml" style="-fx-background-color: #f8f9fa"
	  alignment="CENTER" spacing="15" 
	  fx:controller="com.coreyrobinson.inventory.controller.ChangePasswordController">
	  <padding>
            <Insets top="40" right="40" bottom="40" left="40"/>
      </padding>
      <Label text="Tailgate Tavern" styleClass="screen-header"/>
      <Label text="Change Password" styleClass="section-label" />
      <PasswordField fx:id="currentPasswordField" promptText="Current Password" />
      <PasswordField fx:id="newPasswordField" promptText="New Password" />
      <PasswordField fx:id="confirmNewPasswordField" promptText="Confirm New Password" />
	  <HBox alignment="CENTER" spacing="10">
    	  <Button text="Change Password" onAction="#handleChangePassword" defaultButton="true"/>
    	  <Button text="Cancel" onAction="#handleCancel" cancelButton="true"/>
	  </HBox>
	  <Label fx:id="messageLabel" wrapText="true"/>
</VBox>		  
			
      
	  