<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.coreyrobinson.inventory.controller.MainController"
           prefWidth="800" prefHeight="600">
    
    <VBox alignment="CENTER" spacing="20" maxWidth="600">
        
        <padding>
            <Insets top="40" right="40" bottom="40" left="40"/>
        </padding>
        
        <Label text="Tailgate Tavern" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
        <Label text="Inventory Management" style="-fx-font-size: 16px;"/>
        
        <Label fx:id="welcomeLabel" style="-fx-font-size: 14px;"/>
        <Label fx:id="roleLabel" style="-fx-font-size: 12px; -fx-text-fill: gray;"/>
        
        <Label text="(Main dashboard coming soon...)" style="-fx-font-style: italic;"/>
        
        <Button fx:id="logoutButton" text="Log Out" onAction="#handleLogout" prefWidth="150"/>
        
    </VBox>
    
</StackPane>